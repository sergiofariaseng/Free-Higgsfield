# Configure these only in .env.local (development) or Vercel environment variables.
# Never commit real values. All variables below are server-only.

# Personal login: use distinct, randomly generated values.
APP_PASSWORD=
SESSION_SECRET=

# Higgsfield API (two-part credential; requires API access and provider credits).
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Fine-grained GitHub token restricted to this repository, Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=sergiofariaseng/Free-Higgsfield
GITHUB_BASE_BRANCH=main
GITHUB_STORAGE_BRANCH=studio-storage

# Required for the Vercel scheduled synchronization. Random secret, >=32 characters.
CRON_SECRET=
